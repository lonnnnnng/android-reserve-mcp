{
  "mcp": {
    "servers": {
      "android-reserve": {
        "type": "local",
        "command": ["node", "/absolute/path/android-reserve-mcp/src/cli.js", "--allowedRoots", "/absolute/path/apk-projects"],
        "timeout": 30000,
        "environment": {
          "REA_JADX_HEAP_MIB": "4096",
          "REA_JADX_ACTIVE_PROCESSOR_COUNT": "2"
        }
      }
    }
  }
}
